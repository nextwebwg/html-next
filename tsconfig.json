{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@nextwebwg/html-next": ["./packages/html-next/src/index.ts"],
      "@nextwebwg/html-next/server": ["./packages/html-next/src/server.ts"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "vitest*.config.ts", "packages/html-next-dotnet/benchmarks/**/*.ts", "packages/html-next-dotnet/tests/**/*.ts"],
  "exclude": ["**/dist", "coverage", "node_modules"]
}
