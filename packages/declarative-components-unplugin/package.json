{
  "name": "@nextwebwg/declarative-components-unplugin",
  "version": "1.0.0-alpha.0",
  "description": "unplugin and Vite build pipeline for Declarative HTML Components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@nextwebwg/declarative-components": "workspace:*",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextwebwg/html-next.git",
    "directory": "packages/declarative-components-unplugin"
  }
}
