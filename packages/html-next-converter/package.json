{
  "name": "@nextwebwg/html-next-converter",
  "version": "1.0.0-alpha.81",
  "description": "Vue, React, Preact, and Svelte conversion for Declarative HTML Components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "html-next-convert": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15 <25"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@nextwebwg/html-next": "workspace:>=1.0.0-alpha.81",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@formatjs/intl-durationformat": "0.11.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "css-tree": "catalog:",
    "cssstyle": "catalog:",
    "esbuild": "catalog:",
    "parse5": "catalog:",
    "playwright": "catalog:",
    "preact": "11.1.0",
    "preact-render-to-string": "6.8.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextwebwg/html-next.git",
    "directory": "packages/html-next-converter"
  }
}
