{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@nextwebwg/html-next": [
        "../html-next/src/index.ts"
      ],
      "@nextwebwg/html-next/node-loader": [
        "../html-next/src/node-loader.ts"
      ],
      "@nextwebwg/html-next/generated-runtime": [
        "../html-next/src/generated-runtime.ts"
      ],
      "@nextwebwg/html-next/server": [
        "../html-next/src/server.ts"
      ],
      "@nextwebwg/html-next/runtime": [
        "../html-next/src/runtime.ts"
      ],
      "@nextwebwg/html-next/inputs": [
        "../html-next/src/component-inputs.ts"
      ],
      "@nextwebwg/html-next/bindings": [
        "../html-next/src/bindings.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
