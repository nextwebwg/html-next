{
  "name": "expressmark",
  "version": "0.0.1",
  "description": "Expressive Markdown tooling — initial package reservation; parser and writer are not implemented yet.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15 <25"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "test:package": "vitest run --config vitest.package.config.ts",
    "verify": "pnpm typecheck && pnpm build && pnpm test:package"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://nextwebwg.org/expressive-markdown/",
  "bugs": {
    "url": "https://github.com/nextwebwg/html-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextwebwg/html-next.git",
    "directory": "packages/expressmark"
  }
}
