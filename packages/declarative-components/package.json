{
  "name": "@nextwebwg/declarative-components",
  "version": "0.0.0",
  "private": true,
  "description": "Reference runtime and component bridge for Declarative HTML Components.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "html-next": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./generated-runtime": {
      "types": "./dist/generated-runtime.d.ts",
      "import": "./dist/generated-runtime.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./browser-loader": {
      "types": "./dist/browser-loader.d.ts",
      "import": "./dist/browser-loader.bundle.js"
    },
    "./node-loader": {
      "types": "./dist/node-loader.d.ts",
      "import": "./dist/node-loader.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "audit:native": "tsx scripts/audit-native-features.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsx scripts/build-browser-loader.ts",
    "build:example": "tsx src/cli.ts build examples/x-button.html --out-dir examples/generated",
    "build:looma": "tsx scripts/build-looma-package.ts",
    "check:generated": "tsx scripts/generate-dom-properties.ts --check && tsx scripts/generate-looma-scaffolds.ts --check && tsx scripts/check-example-generated.ts",
    "check:spec": "vitest run --config vitest.config.ts tests/spec.test.ts",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "generate:dom": "tsx scripts/generate-dom-properties.ts",
    "generate:looma": "tsx scripts/generate-looma-inventory.ts",
    "generate:looma-assets": "tsx scripts/generate-looma-assets.ts",
    "generate:looma-scaffolds": "tsx scripts/generate-looma-scaffolds.ts",
    "generate:snapshots": "tsx scripts/update-generate-snapshots.ts",
    "measure:hydration": "tsx scripts/measure-hydration.ts",
    "measure:runtime": "tsx scripts/measure-runtime-size.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config ../../vitest.browser.config.ts",
    "test:consumer": "pnpm build && vitest run --config ../../vitest.consumer.config.ts",
    "test:looma": "vitest run --config ../../vitest.looma.config.ts",
    "test:targets": "vitest run --config ../../vitest.targets.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nextwebwg/html-forms": "workspace:*",
    "typescript-compiler": "npm:@typescript/typescript6@6.0.2",
    "parse5": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/server-renderer": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "reactive-framework-test-suite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
