    "name": "card",
    "rows": 0,
    "html": "<template component=\"x-card\"><defs><prop name=\"title\" type=\"string\" required>Input value.</prop><prop name=\"visible\" type=\"boolean\" required>Input value.</prop></defs><article from:title=\"$title\"><h2 $if=\"$visible\">{$title}</h2></article></template>",
    "liquid": "<article title=\"{{ title }}\">{% if visible %}<h2>{{ title }}</h2>{% endif %}</article>"
  },
  {
