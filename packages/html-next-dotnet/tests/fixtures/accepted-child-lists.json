  {
    "name": "preset-authored-cell-keeps-invocation-attributes",
    "source": "<template component=\"x-column\"><defs><prop name=\"header\" type=\"string\">Heading.</prop><slot name=\"cell\"><prop name=\"item\" type=\"string\">Item.</prop></slot></defs><b><slot name=\"cell\" from:item=\"'Own'\"></slot></b></template><template component=\"x-preset\"><defs><prop name=\"tone\" type=\"string\" default=\"Preset\">Tone.</prop></defs><x-column from:header=\"$tone\"><template slot=\"cell\"><i $attributes>{$tone}:{$item}</i></template></x-column></template><template noforward component=\"x-list\"><defs><slot accepts=\"x-column\" as=\"columns\"></slot></defs><ul><li $each=\"column of $columns\">{$column.header}<slot of=\"$column\" name=\"cell\" from:item=\"'Row'\"></slot></li></ul></template><template component=\"x-page\"><main><x-list id=\"list\"><x-preset tone=\"Caller\" id=\"preset\" class=\"caller\"></x-preset></x-list></main></template>",
    "expected": "<main><ul><li>Caller<i id=\"preset\" class=\"caller\">Caller:Row</i></li></ul></main>"
  },
