    "source": "<template component=\"x-column\"><defs><slot name=\"cell\"></slot></defs><b><slot name=\"cell\">OwnFallback</slot></b></template><template component=\"x-list\"><defs><slot accepts=\"x-column\" as=\"columns\"></slot></defs><section><p $each=\"column of $columns\"><slot of=\"$column\" name=\"cell\">BorrowedFallback</slot></p><slot></slot></section></template><template component=\"x-page\"><main><x-list><x-column><i slot=\"cell\">Plain</i></x-column></x-list></main></template>",
    "expected": "<main><section><p><i slot=\"cell\">Plain</i></p><b>OwnFallback</b></section></main>"
  },
