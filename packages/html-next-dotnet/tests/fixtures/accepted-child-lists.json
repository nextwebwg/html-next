  {
    "name": "computed-owned-entry-alias",
    "source": "<template component=\"x-column\"><defs><slot name=\"cell\"><prop name=\"item\" type=\"string\">Item.</prop></slot></defs><b></b></template><template component=\"x-list\"><defs><slot accepts=\"x-column\" as=\"columns\"></slot><computed name=\"chosen\" from=\"$columns[0]\"></computed></defs><ul><slot of=\"$chosen\" name=\"cell\" from:item=\"'Row'\">Fallback</slot></ul></template><template component=\"x-page\"><main><x-list><x-column><template slot=\"cell\">{$item}</template></x-column></x-list><x-list></x-list></main></template>",
    "expected": "<main><ul>Row</ul><ul>Fallback</ul></main>"
