[
  {
    "name": "literal-ordinary",
    "source": "<template component=\"x-leaf\"><b>Leaf</b></template><template component=\"x-page\"><main><x-leaf id=\"leaf\" title=\"A &amp; B\" data-value=\"&quot;quoted&quot;\" aria-label=\"Label\"></x-leaf></main></template>",
    "expected": "<main><b id=\"leaf\" title=\"A &amp; B\" data-value=\"&quot;quoted&quot;\" aria-label=\"Label\">Leaf</b></main>"
  },
  {
