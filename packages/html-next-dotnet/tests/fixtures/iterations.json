  {
    "name": "distinct-key-types",
    "source": "<template component=\"x-page\"><defs><state name=\"rows\" type=\"unknown\" from=\"[1, '1', true, 'true', null]\"></state></defs><main><b $each=\"row, i of $rows\" $key=\"$row\">{$i}:{$row}</b></main></template>",
