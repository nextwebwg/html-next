  {
    "name": "distinct-object-keys",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row, i of [{ id: 1 }, { id: 1 }]\" $key=\"$row\">{$i}:{$row.id}</b></main></template>",
    "expected": "<main><b>0:1</b><b>1:1</b></main>"
  },
  {
    "name": "deferred-keyed-components",
    "source": "<template component=\"x-leaf\" module=\"./unused.js\"><defs><prop name=\"value\" type=\"number\" required>Value.</prop></defs><b></b></template><template component=\"x-unused\"><section></section></template><template component=\"x-page\"><main><x-unused><x-leaf $each=\"row, i of [3, 1, 2]\" $sort=\"row\" $limit=\"2\" $key=\"$row\" from:value=\"$i + $row\"></x-leaf></x-unused></main></template>",
    "expected": "<main><section></section></main>",
    "native": "<main><section><template carrier=\"x-unused\"><x-leaf value=\"1\"></x-leaf><x-leaf value=\"3\"></x-leaf></template></section></main>",
    "carrier": "<x-leaf value=\"1\"></x-leaf><x-leaf value=\"3\"></x-leaf>"
  },
