[
  {
    "name": "index-alias",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row, i of [10, 20]\">{$i}:{$row}</b></main></template>",
    "expected": "<main><b>0:10</b><b>1:20</b></main>"
  },
  {
    "name": "filtered-indices",
    "source": "<template component=\"x-page\"><defs><state name=\"rows\" type=\"list(number)\" from=\"[1, 2, 3, 4]\"></state></defs><main><b $each=\"row, i of $rows\" $where=\"$row > 2\">{$i}:{$rows.length}:{$row}</b></main></template>",
    "expected": "<main><b>0:4:3</b><b>1:4:4</b></main>"
  },
  {
    "name": "scalar-sort",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row of [3, 1, 2]\" $sort=\"-row\">{$row}</b></main></template>",
    "expected": "<main><b>3</b><b>2</b><b>1</b></main>"
  },
  {
    "name": "stable-sort",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row, i of [{ n: 2, id: 1 }, { n: 1, id: 2 }, { n: 1, id: 3 }]\" $sort=\"row.n\">{$i}:{$row.id}</b></main></template>",
    "expected": "<main><b>0:2</b><b>1:3</b><b>2:1</b></main>"
  },
  {
    "name": "sort-then-limit",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row, i of [{ n: 2, name: 'A' }, { n: 1, name: 'B' }, { n: 1, name: 'C' }]\" $where=\"$row.n > 0\" $sort=\"$row.n,-row.name\" $limit=\"2\" $key=\"$row.name\">{$row.name}:{$i}</b></main></template>",
    "expected": "<main><b>C:0</b><b>B:1</b></main>"
  },
  {
    "name": "limit-truncates",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row of [1, 2, 3]\" $limit=\"2.9\">{$row}</b></main></template>",
    "expected": "<main><b>1</b><b>2</b></main>"
  },
  {
    "name": "negative-limit",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row of [1, 2, 3]\" $limit=\"-2\">{$row}</b></main></template>",
    "expected": "<main></main>"
  },
  {
    "name": "null-limit",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row of [1, 2]\" $limit=\"null\">{$row}</b></main></template>",
    "expected": "<main><b>1</b><b>2</b></main>"
  },
  {
    "name": "empty-loop",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row, i of []\" $key=\"$i\">{$i}</b></main></template>",
    "expected": "<main></main>"
  },
  {
    "name": "keyed-fragment",
    "source": "<template component=\"x-page\"><defs></defs><main><template $each=\"row, i of [2, 1]\" $key=\"$row\"><b>{$i}</b><i>{$row}</i></template></main></template>",
    "expected": "<main><b>0</b><i>2</i><b>1</b><i>1</i></main>"
  },
  {
    "name": "nested-loop-scope",
    "source": "<template component=\"x-page\"><defs></defs><main><section $each=\"outer, i of [10, 20]\"><template $with=\"$i as parent\"><b $each=\"inner, j of [1, 2]\">{$i}:{$j}:{$parent}:{$j}:{$outer + $inner}</b></template><i>{$i}</i></section></main></template>",
    "expected": "<main><section><b>0:0:0:0:11</b><b>0:1:0:1:12</b><i>0</i></section><section><b>1:0:1:0:21</b><b>1:1:1:1:22</b><i>1</i></section></main>"
  },
  {
    "name": "keyed-component",
    "source": "<template component=\"x-leaf\"><defs><prop name=\"value\" type=\"number\">Value.</prop></defs><b>{$value}</b></template><template component=\"x-page\"><defs></defs><main><x-leaf $each=\"row, i of [4, 5]\" $key=\"$row\" from:value=\"$i + $row\"></x-leaf></main></template>",
    "expected": "<main><b>4</b><b>6</b></main>"
  },
  {
    "name": "shaped-slot-content",
    "source": "<template component=\"x-list\"><section><slot></slot></section></template><template component=\"x-page\"><defs></defs><main><x-list><b $each=\"row, i of [3, 1, 2]\" $sort=\"row\" $limit=\"2\" $key=\"$row\">{$i}:{$row}</b></x-list></main></template>",
    "expected": "<main><section><b>0:1</b><b>1:2</b></section></main>",
    "native": "<main><section><?start slot=\"\"?><b>0:1</b><b>1:2</b><?end?></section></main>"
  },
  {
    "name": "shaped-empty-slot-fallback",
    "source": "<template component=\"x-list\"><section><slot>Fallback</slot></section></template><template component=\"x-page\"><defs></defs><main><x-list><b $each=\"row, i of [3, 1, 2]\" $limit=\"0\" $key=\"$row\">{$i}</b></x-list></main></template>",
    "expected": "<main><section>Fallback</section></main>",
    "native": "<main><section><?start slot=\"\" fallback=\"\"?>Fallback<?end?></section></main>"
  },
  {
    "name": "text-sort-collation",
    "source": "<template component=\"x-page\"><defs></defs><main><b $each=\"row of ['z', 'A', '\u00e4', 'a']\" $sort=\"row\">{$row}</b></main></template>",
    "expected": "<main><b>a</b><b>A</b><b>\u00e4</b><b>z</b></main>"
  },
  {
    "name": "limit-from-outer",
