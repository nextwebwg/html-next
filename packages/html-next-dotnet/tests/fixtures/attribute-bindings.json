[
  {
    "name": "boolean-presence",
    "source": "<template component=\"x-attributes\"><defs><prop name=\"active\" type=\"boolean\" default=\"false\">Active.</prop></defs><b from:title=\"$active\" from:id=\"not(not($active))\">Value</b></template>",
    "model": {
      "active": true
    },
    "expected": "<b title=\"\" id=\"\">Value</b>"
  },
  {
    "name": "enumerated-false",
    "source": "<template component=\"x-attributes\"><defs><prop name=\"active\" type=\"boolean\" default=\"false\">Active.</prop></defs><b from:aria-expanded=\"$active\" from:contenteditable=\"$active\" from:draggable=\"$active\" from:spellcheck=\"$active\" from:data-value=\"$active\">Value</b></template>",
    "model": {},
    "expected": "<b aria-expanded=\"false\" contenteditable=\"false\" draggable=\"false\" spellcheck=\"false\">Value</b>"
  },
  {
