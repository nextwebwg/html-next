<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NextWebWG.HtmlNext</PackageId>
    <Version>1.0.0-alpha.2</Version>
    <Authors>Next Web Working Group</Authors>
    <Description>Render HTML Next components from .NET request data, then hydrate the same markup with generated JavaScript for interactive pages. Compile templates once and reuse them across requests.</Description>
    <PackageProjectUrl>https://github.com/nextwebwg/html-next/tree/main/packages/html-next-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nextwebwg/html-next</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>html;templates;ssr;components</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../../assets/brand/html-next-mark-128.png" Pack="true" PackagePath="icon.png" />
    <PackageReference Include="AngleSharp" Version="1.10.0" />
    <PackageReference Include="AngleSharp.Css" Version="1.4.1" />
  </ItemGroup>
</Project>
