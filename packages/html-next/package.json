{
  "name": "@nextwebwg/html-next",
  "version": "1.0.0-alpha.3",
  "description": "Reference runtime for HTML Next: Declarative HTML Components and validity on any element.",
  "license": "MIT",
  "keywords": [
    "components",
    "html",
    "web-components"
  ],
  "homepage": "https://github.com/nextwebwg/html-next#readme",
  "bugs": {
    "url": "https://github.com/nextwebwg/html-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextwebwg/html-next.git",
    "directory": "packages/html-next"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "html-next": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./generated-runtime": {
      "types": "./dist/generated-runtime.d.ts",
      "import": "./dist/generated-runtime.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./browser-loader": {
      "types": "./dist/browser-loader.d.ts",
      "import": "./dist/browser-loader.bundle.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node-loader": {
      "types": "./dist/node-loader.d.ts",
      "import": "./dist/node-loader.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "audit:native": "tsx scripts/audit-native-features.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsx scripts/build-browser-loader.ts",
    "build:example": "tsx src/cli.ts build examples/x-button.html --out-dir examples/generated",
    "check:generated": "tsx scripts/generate-dom-properties.ts --check && tsx scripts/check-example-generated.ts",
    "check:release": "tsx scripts/check-release.ts",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "generate:dom": "tsx scripts/generate-dom-properties.ts",
    "generate:snapshots": "tsx scripts/update-generate-snapshots.ts",
    "measure:hydration": "tsx scripts/measure-hydration.ts",
    "measure:performance": "tsx scripts/measure-performance.ts",
    "measure:reactivity": "tsx scripts/measure-reactivity-matrix.ts",
    "measure:runtime": "tsx scripts/measure-runtime-size.ts",
    "prepack": "pnpm check:release && pnpm build",
    "release:dry-run": "npm pack --dry-run --json",
    "report:performance": "tsx scripts/measure-performance.ts --html",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config ../../vitest.browser.config.ts",
    "test:consumer": "vitest run --config ../../vitest.consumer.config.ts",
    "test:targets": "vitest run --config ../../vitest.targets.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dprint/formatter": "^0.5.1",
    "@dprint/typescript": "^0.96.1",
    "dprint-plugin-malva": "^0.16.0",
    "dprint-plugin-markup": "^0.27.3",
    "parse5": "catalog:",
    "postcss": "catalog:",
    "typescript-compiler": "npm:@typescript/typescript6@6.0.2"
  },
  "devDependencies": {
    "@amadeus-it-group/tansu": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@preact/signals-core": "catalog:",
    "@reactively/core": "catalog:",
    "@reatom/core": "catalog:",
    "@solidjs/signals": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/reactivity": "catalog:",
    "@vue/server-renderer": "catalog:",
    "alien-signals": "catalog:",
    "anod": "catalog:",
    "esbuild": "catalog:",
    "mobx": "catalog:",
    "playwright": "catalog:",
    "pota": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reactive-framework-test-suite": "catalog:",
    "s-js": "catalog:",
    "signal-polyfill": "catalog:",
    "solid-js": "catalog:",
    "svelte": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
