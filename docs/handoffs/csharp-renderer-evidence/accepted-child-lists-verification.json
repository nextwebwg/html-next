    "sections": [
      "slot-accepts-as",
      "content-that-renders-on-demand",
      "columns-as-markup",
      "roots-native-or-delegated"
    ]
  },
  "implementation": {
    "collection": "Explicit as declarations collect accepted props before receiver state initialization. Conditions, three iteration forms, aliases and match arms retain caller scope. Accepts alone does not allocate list records.",
    "presets": "Compiled delegated root calls resolve base props through preset state and explicit scoped-slot forwarding. Borrowed content retains its own invocation attributes.",
    "identity": "Entry provenance is request-local. Indexed and computed aliases retain identity; foreign or copied values fail. Placement reuses resolved props and diagnostics.",
    "content": "Own and borrowed outlets share plain-content claims. Templates render afresh. Implicit ordinary slot contracts and repeated ordinary outlets are supported.",
    "isolation": "Compiled entry types are prepared only for accepted definitions. Mutable collection state is owned by the request and allocated only for explicit lists."
  },
