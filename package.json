{
  "name": "@nextwebwg/html",
  "version": "0.0.0",
  "private": true,
  "description": "Polyfill and component bridge for the HTML Next proposals.",
  "type": "module",
  "bin": {
    "html-next": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.js",
    "./validation": "./dist/validation.js",
    "./browser-loader": "./dist/browser-loader.js",
    "./node-loader": "./dist/node-loader.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:example": "tsx src/cli.ts build examples/x-button.html --out-dir examples/generated",
    "generate:dom": "tsx scripts/generate-dom-properties.ts",
    "generate:looma": "tsx scripts/generate-looma-inventory.ts",
    "generate:looma-scaffolds": "tsx scripts/generate-looma-scaffolds.ts",
    "generate:snapshots": "tsx scripts/update-generate-snapshots.ts",
    "check:generated": "tsx scripts/generate-dom-properties.ts --check",
    "check:spec": "node --import tsx --test test/spec.test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "HTMLNEXT_BROWSER_TEST=1 node --import tsx --test test/runtime.test.ts test/validity.test.ts",
    "test:targets": "HTMLNEXT_TARGET_TEST=1 node --import tsx --test test/targets.test.ts test/target-runtime.test.ts",
    "test:looma": "HTMLNEXT_LOOMA_TEST=1 node --import tsx --test test/migrate-stencil.test.ts test/looma-inventory.test.ts test/package.test.ts test/consumer-knit.test.ts test/consumer-loadops.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/compiler-sfc": "~3.5.42",
    "esbuild": "~0.25.12",
    "playwright": "~1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svelte": "~5.57.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vue": "3.5.42"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "parse5": "~8.0.1"
  }
}
